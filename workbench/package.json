{
  "name": "promptdog-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PromptDog 工作台 · 流程画布 MVP。选型理由见 ../design/workbench/开源选型.md。",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:sample": "tsx scripts/validate-sample.ts",
    "sample": "python3 ../design/workbench/export_flow_json.py && npm run validate:sample",
    "check": "npm run typecheck && npm run lint && npm run validate:sample"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "html-to-image": "1.11.11",
    "jspdf": "^4.2.1",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
